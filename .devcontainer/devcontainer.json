{
  "name": "Cinderella Dub Collection",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Local web server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python3 -m http.server 8000 --directory /workspaces/cinderella-dub-collection"
}
